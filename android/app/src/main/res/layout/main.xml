<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fitsSystemWindows="true" android:orientation="vertical">
    

    <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Network Monitor" android:padding="14dp" android:textSize="18sp" android:textStyle="bold" android:gravity="center"/>
    

    <LinearLayout android:id="@+id/nav_radio" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:visibility="gone">
        <Button android:id="@+id/sub_cell" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Cellule" android:textAllCaps="false" style="?android:attr/borderlessButtonStyle"/>
        <Button android:id="@+id/sub_frames" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Trames" android:textAllCaps="false" style="?android:attr/borderlessButtonStyle"/>
        <Button android:id="@+id/sub_log" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Journal" android:textAllCaps="false" style="?android:attr/borderlessButtonStyle"/>
    </LinearLayout>
    

    <LinearLayout android:id="@+id/nav_node" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:visibility="gone">
        <Button android:id="@+id/node_prev" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="‹" android:textAllCaps="false" style="?android:attr/borderlessButtonStyle" android:textSize="22sp"/>
        <TextView android:id="@+id/node_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textStyle="bold" android:layout_gravity="center_vertical"/>
        <Button android:id="@+id/node_next" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textAllCaps="false" style="?android:attr/borderlessButtonStyle" android:textSize="22sp"/>
    </LinearLayout>
    

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        

        <ScrollView android:id="@+id/scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingLeft="16dp" android:paddingRight="16dp">
                <LinearLayout android:id="@+id/panel_join" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Rejoindre un nœud : un numéro du réseau, sans carte SIM." android:textSize="16sp" android:paddingBottom="8dp"/>
                    <EditText android:id="@+id/user" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Pseudo (ou identifiant SIP)" android:inputType="text"/>
                    <EditText android:id="@+id/secret" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Code d'invitation (ou mot de passe SIP)" android:inputType="textPassword"/>
                    <Button android:id="@+id/btn_join" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="S'inscrire avec le code" android:textAllCaps="false"/>
                    <Button android:id="@+id/btn_direct" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="J'ai déjà un compte SIP" android:textAllCaps="false"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="L'adresse du nœud se règle dans Compte." android:textSize="12sp"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/panel_phone" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                    <LinearLayout android:id="@+id/call_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:padding="28dp" android:layout_marginTop="40dp" android:layout_marginBottom="24dp">
                        <TextView android:id="@+id/call_peer" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:gravity="center" android:textSize="30sp" android:textStyle="bold"/>
                        <TextView android:id="@+id/call_info" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:gravity="center" android:textSize="15sp"/>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="12dp">
                            <Button android:id="@+id/btn_mute" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Micro" android:textAllCaps="false"/>
                            <Button android:id="@+id/btn_spk" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Haut-parleur" android:textAllCaps="false"/>
                        </LinearLayout>
                    </LinearLayout>
                    <EditText android:id="@+id/number" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Numéro" android:inputType="phone" android:gravity="center" android:textSize="30sp"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <Button android:id="@+id/btn_call" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Appeler" android:textAllCaps="false" android:minHeight="64dp"/>
                        <Button android:id="@+id/btn_answer" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Répondre" android:textAllCaps="false" android:minHeight="64dp" android:enabled="false"/>
                        <Button android:id="@+id/btn_hangup" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Raccrocher" android:textAllCaps="false" android:minHeight="64dp" android:enabled="false"/>
                    </LinearLayout>
                    <TextView android:id="@+id/journal" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:paddingTop="12dp" android:textIsSelectable="true"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/panel_radio" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                    <TextView android:id="@+id/radio_rat" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textSize="28sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/radio_metric" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="44sp"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="8dp">
                        <Button android:id="@+id/btn_2g" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Forcer la 2G" android:textAllCaps="false"/>
                        <Button android:id="@+id/btn_auto" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Réseau automatique" android:textAllCaps="false"/>
                    </LinearLayout>
                    <TextView android:id="@+id/net_state" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="12sp" android:textIsSelectable="true"/>
                    <TextView android:id="@+id/radio_cells" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:paddingTop="12dp" android:textIsSelectable="true" android:typeface="monospace"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/panel_log" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                    <TextView android:id="@+id/journal_radio" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textIsSelectable="true" android:paddingTop="8dp"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/panel_node" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                    <org.osmooperator.app.SpectrumView android:id="@+id/spectrum" android:layout_width="match_parent" android:layout_height="420dp"/>
                    <TextView android:id="@+id/services" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:paddingTop="6dp" android:textIsSelectable="true" android:typeface="monospace" android:visibility="gone"/>
                    <LinearLayout android:id="@+id/panel_console" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                        <Spinner android:id="@+id/vty_sel" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                            <EditText android:id="@+id/vty_cmd" android:layout_width="0dp" android:layout_height="wrap_content" android:hint="commande VTY (show …)" android:inputType="text" android:layout_weight="1" android:typeface="monospace"/>
                            <Button android:id="@+id/btn_vty" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="→" android:textAllCaps="false"/>
                        </LinearLayout>
                        <TextView android:id="@+id/vty_out" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textIsSelectable="true" android:typeface="monospace"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:id="@+id/panel_proxy" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textStyle="bold" android:textSize="18sp" android:text="Proxy : le banc dans les applis du téléphone"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="8dp" android:text="Activé, les appels du numéro du banc sonnent dans l&apos;appli Téléphone normale (écran d&apos;appel, journal), et son clavier peut appeler par le compte « Banc ». Les SMS du banc arrivent en notification. Ils ne s&apos;affichent plus ici."/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <Button android:id="@+id/btn_natif_on" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Activer" android:textAllCaps="false"/>
                        <Button android:id="@+id/btn_natif_off" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Désactiver" android:textAllCaps="false"/>
                    </LinearLayout>
                    <Button android:id="@+id/btn_natif_comptes" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Comptes téléphoniques (activer « Banc »)" android:textAllCaps="false"/>
                    <TextView android:id="@+id/natif_state" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="8dp" android:paddingBottom="22dp" android:textIsSelectable="true"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textStyle="bold" android:textSize="18sp" android:text="Prêter la carte SIM au banc"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="8dp" android:text="Les SMS reçus par la SIM arrivent aussi sur le banc ; un SMS du banc vers un numéro extérieur (06…, +33…) part par cette SIM. Quand la SIM sonne, le banc est prévenu. La voix d&apos;un appel ne passe pas par l&apos;appli : Android ne la donne à aucune appli."/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="14dp" android:textStyle="bold" android:text="Destinataire sur le banc"/>
                    <EditText android:id="@+id/proxy_dest" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="100101 ou 3001" android:inputType="phone"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <Button android:id="@+id/btn_proxy_on" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Activer" android:textAllCaps="false"/>
                        <Button android:id="@+id/btn_proxy_off" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Désactiver" android:textAllCaps="false"/>
                    </LinearLayout>
                    <TextView android:id="@+id/proxy_state" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="12dp" android:textIsSelectable="true"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/panel_account" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nœud : IP locale, WireGuard ou VPS" android:textStyle="bold"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <EditText android:id="@+id/node" android:layout_width="0dp" android:layout_height="wrap_content" android:hint="192.168.1.20" android:inputType="textUri" android:layout_weight="1"/>
                        <Button android:id="@+id/btn_node" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="OK" android:textAllCaps="false"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/panel_trunk" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="14dp">
                        <TextView android:id="@+id/trunk_state" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sortie vers l'extérieur : —" android:textStyle="bold"/>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                            <Button android:id="@+id/btn_zadarma" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Zadarma" android:textAllCaps="false"/>
                            <Button android:id="@+id/btn_dongle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Dongle" android:textAllCaps="false"/>
                        </LinearLayout>
                    </LinearLayout>
                    <TextView android:id="@+id/mode_state" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Mode" android:paddingTop="14dp" android:textStyle="bold"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <Button android:id="@+id/btn_mode0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Basique" android:textAllCaps="false"/>
                        <Button android:id="@+id/btn_mode1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Medium" android:textAllCaps="false"/>
                        <Button android:id="@+id/btn_mode2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Expert" android:textAllCaps="false"/>
                    </LinearLayout>
                    <TextView android:id="@+id/theme_state" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Thème" android:paddingTop="14dp" android:textStyle="bold"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <Button android:id="@+id/btn_theme0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Clair" android:textAllCaps="false"/>
                        <Button android:id="@+id/btn_theme1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Sombre" android:textAllCaps="false"/>
                        <Button android:id="@+id/btn_theme2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Système" android:textAllCaps="false"/>
                    </LinearLayout>
                    <TextView android:id="@+id/account" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:paddingTop="14dp" android:textIsSelectable="true"/>
                    <Button android:id="@+id/btn_wipe" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Effacer les appels et conversations" android:textAllCaps="false"/>
                    <Button android:id="@+id/btn_leave" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Quitter ce nœud" android:textAllCaps="false"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
        

        <LinearLayout android:id="@+id/panel_frames" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone">
            <TextView android:id="@+id/frames_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="12sp" android:paddingLeft="12dp" android:paddingRight="12dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingLeft="8dp" android:paddingRight="8dp">
                <EditText android:id="@+id/frames_filter" android:layout_width="0dp" android:layout_height="wrap_content" android:hint="filtre : LAPDm, DTAP, SMS, UL, SABM…" android:inputType="text" android:layout_weight="1" android:textSize="14sp"/>
                <Button android:id="@+id/frames_pause" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⏸" android:textAllCaps="false"/>
                <Button android:id="@+id/frames_clear" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✕" android:textAllCaps="false"/>
            </LinearLayout>
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
                <LinearLayout android:id="@+id/frames_cats" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingLeft="8dp" android:paddingRight="8dp"/>
            </HorizontalScrollView>
            <ListView android:id="@+id/frames_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@null" android:transcriptMode="normal" android:stackFromBottom="false"/>
        </LinearLayout>
        

        <LinearLayout android:id="@+id/panel_messages" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingLeft="12dp" android:paddingRight="12dp">
                <EditText android:id="@+id/msg_to" android:layout_width="0dp" android:layout_height="wrap_content" android:hint="À (numéro)" android:inputType="phone" android:layout_weight="1"/>
                <Button android:id="@+id/msg_wipe" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🗑" android:textAllCaps="false"/>
            </LinearLayout>
            <ScrollView android:id="@+id/msg_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
                <LinearLayout android:id="@+id/msg_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="bottom" android:padding="12dp"/>
            </ScrollView>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingLeft="12dp" android:paddingRight="12dp">
                <EditText android:id="@+id/msg_text" android:layout_width="0dp" android:layout_height="wrap_content" android:hint="Message" android:inputType="textMultiLine" android:layout_weight="1"/>
                <Button android:id="@+id/msg_send" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Envoyer" android:textAllCaps="false"/>
            </LinearLayout>
        </LinearLayout>
        

    </FrameLayout>
    

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/tab_phone" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:text="Tél." android:textAllCaps="false" android:textSize="12sp" android:paddingLeft="2dp" android:paddingRight="2dp"/>
        <Button android:id="@+id/tab_messages" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:text="Messages" android:textAllCaps="false" android:textSize="12sp" android:paddingLeft="2dp" android:paddingRight="2dp"/>
        <Button android:id="@+id/tab_radio" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:text="Radio" android:textAllCaps="false" android:textSize="12sp" android:paddingLeft="2dp" android:paddingRight="2dp"/>
        <Button android:id="@+id/tab_node" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:text="Nœud" android:textAllCaps="false" android:textSize="12sp" android:paddingLeft="2dp" android:paddingRight="2dp"/>
        <Button android:id="@+id/tab_proxy" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:text="Proxy" android:textAllCaps="false" android:textSize="12sp" android:paddingLeft="2dp" android:paddingRight="2dp"/>
        <Button android:id="@+id/tab_account" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:text="Compte" android:textAllCaps="false" android:textSize="12sp" android:paddingLeft="2dp" android:paddingRight="2dp"/>
    </LinearLayout>
    

</LinearLayout>
