# Maintainer: Bastien Baranoff <bastienbaranoff@gmail.com>
# Paquet postmarketOS (Alpine) de Network Monitor. Construit par ../build-apk.sh
# (abuild dans le chroot natif de pmbootstrap) ; ne pas lancer abuild ici
# directement, les sources sont dans le dossier parent.
pkgname=network-monitor
pkgver=0.10.2
pkgrel=0
pkgdesc="Cellular monitor and SIM-less phone for Phosh, client of an osmo-operator node"
url="https://github.com/bbaranoff/osmo-operator"
arch="noarch"
license="GPL-3.0-or-later"
depends="python3 py3-gobject3 py3-cairo gtk4.0 libadwaita libsoup3 libmm-glib modemmanager py3-pjsua"
options="!check"
source="network-monitor.py
	org.osmocom.NetworkMonitor.desktop
	org.osmocom.NetworkMonitor.svg
	clair.jpg
	sombre.jpg"
builddir="$srcdir"

package() {
	install -Dm755 "$srcdir"/network-monitor.py "$pkgdir"/usr/bin/network-monitor
	install -Dm644 "$srcdir"/org.osmocom.NetworkMonitor.desktop \
		"$pkgdir"/usr/share/applications/org.osmocom.NetworkMonitor.desktop
	install -Dm644 "$srcdir"/org.osmocom.NetworkMonitor.svg \
		"$pkgdir"/usr/share/icons/hicolor/scalable/apps/org.osmocom.NetworkMonitor.svg
	for f in clair sombre; do
		install -Dm644 "$srcdir"/$f.jpg "$pkgdir"/usr/share/network-monitor/fonds/$f.jpg
	done
}

sha512sums="
