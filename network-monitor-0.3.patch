+#   Basique : Téléphone, Messages, Compte.
+#   Medium  : + Radio (cellule, signal, voisines) et Nœud (spectres, services).
+#   Expert  : + trames, journal, console VTY, choix de la sortie.
+MODES = ("Basique", "Medium", "Expert")
